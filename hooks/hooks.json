{
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/trocar-conta.js\" trocar --hook",
            "timeout": 21000,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/trocar-conta.js\" lembrete",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
